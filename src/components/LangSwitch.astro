---
// 同じページの別言語版へ移動するリンク
import { localeLabels, locales } from '../i18n/ui';
import { getLocale, switchLocalePath, useTranslations } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<div class="flex items-center gap-2 text-sm" aria-label={t('lang.switch')}>
  {
    locales.map((l) =>
      l === lang ? (
        <span class="font-display font-bold text-ink" aria-current="true">
          {localeLabels[l]}
        </span>
      ) : (
        <a
          href={switchLocalePath(Astro.url.pathname, l)}
          hreflang={l}
          lang={l}
          class="font-display font-semibold text-neutral-400 hover:text-brand-600"
        >
          {localeLabels[l]}
        </a>
      ),
    )
  }
</div>
