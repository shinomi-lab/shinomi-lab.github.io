---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getLocale, localizePath, useTranslations } from '../i18n/utils';
import { splitLocaleId } from '../lib/content';

interface Props {
  entries: CollectionEntry<'news'>[];
}
const { entries } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

{
  entries.length === 0 ? (
    <p class="text-neutral-500">{t('news.empty')}</p>
  ) : (
    <ul class="divide-y divide-black/10">
      {entries.map((entry) => (
        <li class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-8">
          <time
            datetime={entry.data.date.toISOString()}
            class="shrink-0 font-display text-sm font-semibold text-brand-600 sm:w-40"
          >
            {formatDate(entry.data.date, lang)}
          </time>
          <a
            href={localizePath(lang, `news/${splitLocaleId(entry.id).slug}`)}
            class="font-medium text-ink hover:text-brand-600"
          >
            {entry.data.title}
          </a>
        </li>
      ))}
    </ul>
  )
}
