---
import { siteConfig } from '../config';
import { getLocale, localizePath, pick, useTranslations } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const nav = [
  { href: localizePath(lang), label: t('nav.home') },
  { href: localizePath(lang, 'research'), label: t('nav.research') },
  { href: localizePath(lang, 'members'), label: t('nav.members') },
  { href: localizePath(lang, 'publications'), label: t('nav.publications') },
  { href: localizePath(lang, 'news'), label: t('nav.news') },
  { href: localizePath(lang, 'access'), label: t('nav.access') },
];
const current = Astro.url.pathname;
// ホームは完全一致、それ以外は配下のページ（例: /news/xxx/）も含めて現在地とみなす
const home = localizePath(lang);
const isActive = (href: string) => (href === home ? current === href : current.startsWith(href));
---

<header class="sticky top-0 z-30 border-b border-black/10 bg-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:h-20 sm:px-8">
    <a href={localizePath(lang)} class="flex items-center gap-3">
      <img
        src={`${import.meta.env.BASE_URL}favicon.svg`}
        alt=""
        width="36"
        height="36"
        class="size-9 rounded-lg"
      />
      <span class="leading-tight">
        <span class="block font-display text-base font-extrabold tracking-tight text-ink sm:text-lg">
          {pick(siteConfig.name, lang)}
        </span>
        <span class="hidden text-[11px] text-neutral-500 sm:block">
          {pick(siteConfig.affiliation, lang)}
        </span>
      </span>
    </a>

    <!-- PC 用ナビゲーション -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label={t('nav.primary')}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative font-display text-sm font-semibold transition-colors hover:text-brand-600',
              'after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:bg-brand-600 after:transition-all',
              isActive(item.href)
                ? 'text-brand-600 after:w-full'
                : 'text-black/80 after:w-0 hover:after:w-full',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <span class="h-5 w-px bg-black/15" aria-hidden="true"></span>
      <LangSwitch />
    </nav>

    <!-- スマホ用ナビゲーション（JavaScript なしで開閉） -->
    <details class="group lg:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-ink hover:bg-surface"
        aria-label={t('nav.menu')}
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2">
          <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav
        class="absolute inset-x-0 top-full border-b border-black/10 bg-white px-5 pb-6 shadow-lg"
        aria-label={t('nav.primary')}
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block border-b border-black/5 py-4 font-display font-semibold text-ink"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <div class="pt-4"><LangSwitch /></div>
      </nav>
    </details>
  </div>
</header>
