---
import { siteConfig } from '../config';
import { getLocale, localizePath, pick, useTranslations } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const nav = [
  { href: localizePath(lang, 'research'), label: t('nav.research') },
  { href: localizePath(lang, 'members'), label: t('nav.members') },
  { href: localizePath(lang, 'publications'), label: t('nav.publications') },
  { href: localizePath(lang, 'news'), label: t('nav.news') },
  { href: localizePath(lang, 'access'), label: t('nav.access') },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(href);
---

<header class="border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localizePath(lang)} class="leading-tight">
      <span class="block text-lg font-bold text-brand-900">{pick(siteConfig.name, lang)}</span>
      <span class="block text-xs text-slate-500">{pick(siteConfig.affiliation, lang)}</span>
    </a>

    <!-- PC 用ナビゲーション -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm hover:text-brand-600',
              isActive(item.href) ? 'font-semibold text-brand-700' : 'text-slate-600',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <LangSwitch />
    </nav>

    <!-- スマホ用ナビゲーション（JavaScript なしで開閉） -->
    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded border border-slate-300 px-3 py-1.5 text-sm text-slate-700"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 z-10 mt-2 flex w-48 flex-col gap-1 rounded border border-slate-200 bg-white p-2 shadow-lg"
        aria-label="Main"
      >
        {
          nav.map((item) => (
            <a href={item.href} class="rounded px-3 py-2 text-sm hover:bg-brand-50">
              {item.label}
            </a>
          ))
        }
        <div class="border-t border-slate-200 px-3 pt-2"><LangSwitch /></div>
      </nav>
    </details>
  </div>
</header>
