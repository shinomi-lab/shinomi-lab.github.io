---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLocale, pick } from '../i18n/utils';
import { roleLabels } from '../lib/labels';

interface Props {
  member: CollectionEntry<'members'>;
}
const { member } = Astro.props;
const { name, role, photo, research, links, enrolledYear, graduatedYear } = member.data;
const lang = getLocale(Astro.currentLocale);
const displayName = pick(name, lang);
---

<article class="flex gap-4 rounded-lg border border-slate-200 p-4">
  {
    photo ? (
      <Image
        src={photo}
        alt={displayName}
        width={80}
        height={80}
        class="size-20 shrink-0 rounded-full object-cover"
      />
    ) : (
      <div
        class="flex size-20 shrink-0 items-center justify-center rounded-full bg-brand-100 text-2xl font-bold text-brand-700"
        aria-hidden="true"
      >
        {displayName.slice(0, 1)}
      </div>
    )
  }
  <div class="min-w-0">
    <p class="text-xs text-slate-500">
      {roleLabels[role][lang]}
      {graduatedYear !== undefined && ` (${enrolledYear ?? ""}–${graduatedYear})`}
    </p>
    <h3 class="font-semibold text-slate-900">{displayName}</h3>
    {research && <p class="mt-1 text-sm text-slate-600">{pick(research, lang)}</p>}
    {
      links.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-3 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.url} class="text-brand-600 hover:underline" rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
