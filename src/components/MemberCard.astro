---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLocale, pick } from '../i18n/utils';
import { roleLabels } from '../lib/labels';

interface Props {
  member: CollectionEntry<'members'>;
}
const { member } = Astro.props;
const { name, role, photo, research, links, enrolledYear, graduatedYear } = member.data;
const lang = getLocale(Astro.currentLocale);
const displayName = pick(name, lang);
---

<article class="group">
  <div class="aspect-square overflow-hidden rounded-sm bg-brand-100">
    {
      photo ? (
        <Image
          src={photo}
          alt={displayName}
          widths={[320, 640]}
          sizes="(min-width: 1024px) 25vw, 50vw"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div
          class="flex size-full items-center justify-center font-display text-6xl font-extrabold text-brand-300"
          aria-hidden="true"
        >
          {displayName.slice(0, 1)}
        </div>
      )
    }
  </div>
  <h3 class="mt-4 font-display text-lg font-bold">{displayName}</h3>
  <p class="font-display text-xs font-bold tracking-wider text-brand-600 uppercase">
    {roleLabels[role][lang]}
    {graduatedYear !== undefined && ` · ${enrolledYear ?? ''}–${graduatedYear}`}
  </p>
  {research && <p class="mt-2 text-sm text-neutral-600">{pick(research, lang)}</p>}
  {
    links.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-3 text-sm">
        {links.map((link) => (
          <li>
            <a href={link.url} class="font-semibold text-brand-600 hover:underline" rel="noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
