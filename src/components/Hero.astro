---
import { Image } from 'astro:assets';
// トップページのメインビジュアル。
// src/assets/hero.(jpg|png|webp) を置くとその画像を背景に使い、無ければグラフ模様を表示する。
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../config';
import { getLocale, pick, useTranslations } from '../i18n/utils';
import NetworkPattern from './NetworkPattern.astro';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp}',
  { eager: true },
);
const heroImage = Object.values(heroImages)[0]?.default;
---

<section class="relative isolate flex min-h-[70vh] items-end overflow-hidden bg-brand-900 text-white">
  {
    heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={[800, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        class="absolute inset-0 -z-10 size-full object-cover"
      />
    ) : (
      <NetworkPattern seed={3} nodes={70} class="absolute inset-0 -z-10 size-full text-brand-300" />
    )
  }
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
  <div class="mx-auto w-full max-w-6xl px-5 pt-32 pb-16 sm:px-8 sm:pb-24">
    <p class="font-display text-sm font-semibold tracking-wide text-brand-100">
      {pick(siteConfig.affiliation, lang)}
    </p>
    <h1
      class="mt-3 font-display text-5xl font-extrabold tracking-tight text-white sm:text-7xl"
    >
      {pick(siteConfig.name, lang)}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-white/85">{pick(siteConfig.description, lang)}</p>
  </div>
  <span
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 font-display text-[11px] tracking-[0.3em] text-white/60 uppercase sm:block"
    aria-hidden="true"
  >
    {t('home.scroll')}
  </span>
</section>
