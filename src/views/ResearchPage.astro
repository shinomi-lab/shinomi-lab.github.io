---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearch, splitLocaleId } from '../lib/content';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const topics = await Promise.all(
  (await getResearch(lang)).map(async (topic) => ({ topic, ...(await render(topic)) })),
);
---

<BaseLayout title={t('nav.research')}>
  <PageHeader title={t('nav.research')} />
  <div class="space-y-14">
    {
      topics.map(({ topic, Content }) => (
        <section id={splitLocaleId(topic.id).slug} class="scroll-mt-6">
          <h2 class="text-2xl font-bold text-brand-900">{topic.data.title}</h2>
          <p class="mt-2 text-slate-600">{topic.data.summary}</p>
          {topic.data.image && (
            <Image src={topic.data.image} alt="" class="mt-6 w-full rounded-lg" />
          )}
          <div class="prose prose-slate mt-6 max-w-none">
            <Content />
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
