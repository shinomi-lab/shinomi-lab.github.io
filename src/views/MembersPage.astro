---
import MemberCard from '../components/MemberCard.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMembers } from '../lib/content';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const { faculty, students, alumni } = await getMembers();
const groups = [
  { title: t('members.faculty'), members: faculty },
  { title: t('members.students'), members: students },
  { title: t('members.alumni'), members: alumni },
].filter((g) => g.members.length > 0);
---

<BaseLayout title={t('nav.members')}>
  <PageHeader title={t('nav.members')} />
  <div class="space-y-12">
    {
      groups.map((group) => (
        <section>
          <h2 class="mb-4 text-xl font-bold text-brand-900">{group.title}</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {group.members.map((member) => (
              <MemberCard member={member} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
