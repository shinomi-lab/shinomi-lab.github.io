---
import Hero from '../components/Hero.astro';
import MemberCard from '../components/MemberCard.astro';
import NewsList from '../components/NewsList.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ResearchTile from '../components/ResearchTile.astro';
import Section from '../components/Section.astro';
import { getLocale, localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMembers, getNews, getPublications, getResearch, splitLocaleId } from '../lib/content';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const research = await getResearch(lang);
const { faculty } = await getMembers();
const publications = (await getPublications()).slice(0, 3);
const news = (await getNews(lang)).slice(0, 5);
---

<BaseLayout>
  <Hero />

  <Section title={t('home.research')} tone="surface" compact>
    <div class="grid gap-6 md:grid-cols-2">
      {
        research.map((topic, i) => (
          <ResearchTile
            topic={topic}
            index={i}
            href={`${localizePath(lang, 'research')}#${splitLocaleId(topic.id).slug}`}
          />
        ))
      }
    </div>
  </Section>

  <Section title={t('home.people')} lead={t('home.peopleLead')}>
    <div class="mx-auto grid max-w-4xl grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-4">
      {faculty.map((member) => <MemberCard member={member} />)}
    </div>
    <div class="mt-12 text-center">
      <a href={localizePath(lang, 'members')} class="btn-pill">{t('members.allMembers')} →</a>
    </div>
  </Section>

  {
    publications.length > 0 && (
      <Section title={t('home.publications')} tone="surface">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {publications.map((pub, i) => (
            <PublicationCard pub={pub} index={i} />
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href={localizePath(lang, 'publications')} class="btn-pill">
            {t('common.more')} →
          </a>
        </div>
      </Section>
    )
  }

  <Section title={t('home.news')}>
    <div class="mx-auto max-w-3xl">
      <NewsList entries={news} />
    </div>
    <div class="mt-12 text-center">
      <a href={localizePath(lang, 'news')} class="btn-pill">{t('common.more')} →</a>
    </div>
  </Section>
</BaseLayout>
