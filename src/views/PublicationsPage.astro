---
import { render } from 'astro:content';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublications } from '../lib/content';
import { publicationTypeLabels } from '../lib/labels';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const publications = await Promise.all(
  (await getPublications()).map(async (pub) => ({ pub, ...(await render(pub)) })),
);

// 年ごとにまとめる（新しい年が先）
const byYear = Map.groupBy(publications, ({ pub }) => pub.data.date.getFullYear());
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title={t('nav.publications')}>
  <PageHeader title={t('nav.publications')} />
  <Container class="py-16 sm:py-24">
  {publications.length === 0 && <p class="text-neutral-500">{t('publications.empty')}</p>}
  <div class="space-y-16">
    {
      years.map((year) => (
        <section>
          <h2 class="mb-6 border-b border-black/10 pb-3 font-display text-3xl font-extrabold">{year}</h2>
          <ol class="space-y-8">
            {byYear.get(year)?.map(({ pub, Content }) => (
              <li>
                <p class="font-display text-xs font-bold tracking-wider text-brand-600 uppercase">
                  {publicationTypeLabels[pub.data.type][lang]}
                </p>
                <p class="mt-1 font-display text-lg font-bold text-ink">
                  {pub.data.url ? (
                    <a href={pub.data.url} class="hover:text-brand-600 hover:underline">
                      {pub.data.title}
                    </a>
                  ) : (
                    pub.data.title
                  )}
                </p>
                <p class="text-sm text-neutral-600">{pub.data.authors.join(', ')}</p>
                <p class="text-sm text-neutral-500 italic">{pub.data.venue}</p>
                {pub.data.doi && (
                  <a
                    href={`https://doi.org/${pub.data.doi}`}
                    class="text-sm text-brand-600 hover:underline"
                  >
                    doi:{pub.data.doi}
                  </a>
                )}
                {pub.body?.trim() && (
                  <div class="prose prose-sm prose-neutral mt-1 max-w-none">
                    <Content />
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  </Container>
</BaseLayout>
