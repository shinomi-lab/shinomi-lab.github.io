---
import Container from '../components/Container.astro';
import NewsList from '../components/NewsList.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNews } from '../lib/content';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const news = await getNews(lang);
---

<BaseLayout title={t('nav.news')}>
  <PageHeader title={t('nav.news')} />
  <Container class="max-w-4xl py-16 sm:py-24">
    <NewsList entries={news} />
  </Container>
</BaseLayout>
