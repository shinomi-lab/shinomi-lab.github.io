---
import { type CollectionEntry, render } from 'astro:content';
import Container from '../components/Container.astro';
import { formatDate, getLocale, localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'news'>;
}
const { entry } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <Container class="max-w-3xl py-16 sm:py-24">
  <article>
    <time datetime={entry.data.date.toISOString()} class="font-display text-sm font-semibold text-brand-600">
      {formatDate(entry.data.date, lang)}
    </time>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-5xl">{entry.data.title}</h1>
    <div class="prose prose-neutral mt-8 max-w-none">
      <Content />
    </div>
  </article>
  <a href={localizePath(lang, 'news')} class="btn-pill mt-14">
    ← {t('common.backToList')}
  </a>
  </Container>
</BaseLayout>
