---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../config';
import { locales } from '../i18n/ui';
import { getLocale, pick, switchLocalePath, useTranslations } from '../i18n/utils';
import '@fontsource-variable/montserrat';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';

interface Props {
  /** ページ固有のタイトル。省略するとサイト名のみ */
  title?: string;
  description?: string;
}

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const siteName = pick(siteConfig.name, lang);
const { title, description = pick(siteConfig.description, lang) } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp}',
  { eager: true },
);
const heroImage = Object.values(heroImages)[0]?.default;
const socialImage = heroImage
  ? await getImage({
      src: heroImage,
      width: 1200,
      height: 630,
      fit: 'cover',
      position: 'bottom',
      format: 'jpg',
      quality: 85,
    })
  : undefined;
const socialImageUrl = socialImage && Astro.site ? new URL(socialImage.src, Astro.site) : undefined;
const socialImageAlt =
  lang === 'ja' ? '篠宮研究室のメンバー集合写真' : 'A group photo of Shinomiya Laboratory members';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site)}
        />
      ))
    }
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      socialImageUrl && (
        <>
          <meta name="twitter:card" content="summary_large_image" />
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={socialImageAlt} />
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={socialImageAlt} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-ink focus:shadow-lg"
    >
      {t('a11y.skipToContent')}
    </a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
